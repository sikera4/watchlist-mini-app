# Telegram bot credentials. Server-only; never prefix this with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Firebase Admin credentials used by the Next.js server.
# Prefer workload identity/application default credentials in managed environments.
FIREBASE_PROJECT_ID=watchlist-1f961
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# TMDB access token. This remains public until TMDB requests are moved server-side.
NEXT_PUBLIC_API_TOKEN=
