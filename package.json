{
  "name": "watchlist-mini-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:ui": "vitest run",
    "audit:memberships": "node scripts/audit-firestore-memberships.mjs",
    "normalize:user-ids": "node scripts/normalize-firestore-user-ids.mjs",
    "test:normalization": "node --test tests/normalize-user-ids.test.mjs",
    "repair:references": "node scripts/repair-firestore-references.mjs",
    "test:repairs": "node --test tests/repair-references.test.mjs",
    "test:audit": "node --test tests/audit-memberships.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-watchlist-rules \"node --experimental-strip-types --test tests/firestore.rules.test.mjs\"",
    "lint:prettier": "prettier --write 'src/**/*.{ts,tsx}'",
    "prepare": "husky",
    "husky:precommit": "lint-staged"
  },
  "dependencies": {
    "@heroui/react": "2.8.7",
    "@tanstack/react-query": "5.90.7",
    "firebase": "12.6.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "12.23.24",
    "next": "16.0.10",
    "next-intl": "4.4.0",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.66.0",
    "react-icons": "5.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/postcss": "4",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/telegram-web-app": "9.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9",
    "eslint-config-next": "16.0.1",
    "firebase-tools": "15.35.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "16.2.7",
    "prettier": "3.6.2",
    "tailwindcss": "4",
    "typescript": "5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "22",
    "pnpm": "10"
  },
  "packageManager": "pnpm@10.8.1"
}
